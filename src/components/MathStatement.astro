---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<section class="math-statement" aria-label={label}>
  <p class="statement-label">{label}</p>
  <slot />
</section>

<style>
  .math-statement {
    --math-inset: clamp(0.875rem, 3vw, 1.25rem);
    --math-border: color-mix(in srgb, var(--accent) 24%, var(--background));
    --math-radius: 0.625rem;

    margin-block: 1.5rem;
    border: 1px solid var(--math-border);
    border-radius: var(--math-radius);
    background: color-mix(in srgb, var(--accent) 6%, var(--background));
  }

  .math-statement > :global(:not(.math-proof)) {
    margin-inline: var(--math-inset);
  }

  .math-statement > :global(:last-child:not(.math-proof)) {
    margin-block-end: 1rem;
  }

  .math-statement > .statement-label {
    margin-block: 0.875rem 0.25rem;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 650;
  }

  .statement-label + :global(p),
  .statement-label + :global(.katex-display) {
    margin-block-start: 0.25rem;
  }
</style>
