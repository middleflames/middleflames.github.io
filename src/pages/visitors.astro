---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import worldMap from "@/assets/visitor-world-map.svg?raw";
import config from "@/config";
---

<Layout
  title={`Visitors | ${config.site.title}`}
  description="Visitor statistics and approximate locations for Hao's Output Layer."
>
  <Header />
  <Breadcrumb />

  <Main
    pageTitle="Visitors"
    pageDesc="A cumulative view of where this blog's readers come from."
  >
    <section
      aria-labelledby="visitor-map-heading"
      class="border-border bg-muted/20 rounded-lg border p-5 sm:p-8"
    >
      <h2 id="visitor-map-heading" class="text-xl font-semibold">
        Visitor history
      </h2>
      <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
        The map colors countries with recorded visits since location tracking
        began. Locations are approximate. Visits with an unknown country are
        counted below but cannot be placed on the map.
      </p>

      <dl class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
        <div>
          <dt class="text-muted-foreground text-sm">Unique visitors</dt>
          <dd
            class="text-accent mt-1 text-2xl font-semibold tabular-nums"
            data-visitor-count="busuanzi_site_uv"
          >
            —
          </dd>
        </div>
        <div>
          <dt class="text-muted-foreground text-sm">Page views</dt>
          <dd
            class="text-accent mt-1 text-2xl font-semibold tabular-nums"
            data-visitor-count="busuanzi_site_pv"
          >
            —
          </dd>
        </div>
        <div>
          <dt class="text-muted-foreground text-sm">Located visits</dt>
          <dd
            class="text-accent mt-1 text-2xl font-semibold tabular-nums"
            data-located-visits
          >
            —
          </dd>
        </div>
      </dl>

      <div
        class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_12rem] lg:items-start"
      >
        <div
          class="border-border bg-background overflow-hidden rounded-lg border p-3 dark:bg-[#171e2b]"
        >
          <div
            class="visitor-world-map"
            set:html={worldMap}
            aria-hidden="true"
          />
        </div>
        <div>
          <h3 class="font-semibold">Visits by country</h3>
          <ul data-visitor-countries class="mt-3 space-y-2 text-sm">
            <li class="text-muted-foreground">Loading locations…</li>
          </ul>
          <p
            data-visitor-history-status
            class="text-muted-foreground mt-4 text-xs"
            role="status"
          >
          </p>
          <a
            class="text-accent mt-4 inline-block text-xs underline underline-offset-4"
            href="https://feed-pulse.com/site/middleflames.github.io/traffic"
            target="_blank"
            rel="noopener noreferrer"
          >
            Location data by FeedPulse
          </a>
        </div>
      </div>
    </section>
  </Main>

  <Footer />
</Layout>

<style is:global>
  .visitor-world-map svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .visitor-world-map path {
    fill: var(--muted);
    stroke: var(--background);
    stroke-width: 0.7;
    vector-effect: non-scaling-stroke;
    transition: fill 180ms ease;
  }

  .visitor-world-map path[data-level="1"] {
    fill: color-mix(in srgb, var(--accent) 50%, var(--muted));
  }

  .visitor-world-map path[data-level="2"] {
    fill: color-mix(in srgb, var(--accent) 65%, var(--muted));
  }

  .visitor-world-map path[data-level="3"] {
    fill: color-mix(in srgb, var(--accent) 80%, var(--muted));
  }

  .visitor-world-map path[data-level="4"] {
    fill: var(--accent);
  }
</style>
