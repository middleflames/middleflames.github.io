---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
---

<Layout
  title={`Visitors | ${config.site.title}`}
  description="Visitor statistics and approximate locations for Hao's Output Layer."
>
  <Header />
  <Breadcrumb />

  <Main
    pageTitle="Visitors"
    pageDesc="A look at this blog's readers around the world."
  >
    <section
      aria-labelledby="visitor-map-heading"
      class="border-border bg-muted/20 grid gap-6 rounded-lg border p-5 sm:p-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] md:items-center"
    >
      <div>
        <h2 id="visitor-map-heading" class="text-xl font-semibold">
          Visitor map
        </h2>
        <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
          The globe shows visits from the last 24 hours when their approximate
          location is available. The totals below cover all time.
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-4">
          <div>
            <dt class="text-muted-foreground text-sm">All-time visitors</dt>
            <dd
              class="text-accent mt-1 text-2xl font-semibold tabular-nums"
              data-visitor-count="busuanzi_site_uv"
            >
              —
            </dd>
          </div>
          <div>
            <dt class="text-muted-foreground text-sm">All-time page views</dt>
            <dd
              class="text-accent mt-1 text-2xl font-semibold tabular-nums"
              data-visitor-count="busuanzi_site_pv"
            >
              —
            </dd>
          </div>
        </dl>
      </div>

      <div
        class="border-border bg-background flex min-h-96 items-center justify-center overflow-hidden rounded-lg border p-2 dark:bg-[#171e2b]"
      >
        <iframe
          data-visitor-map
          data-frame-url={getAssetPath("visitor-map-frame.html")}
          title="Recent visitor locations on a globe"
          class="h-[430px] w-full border-0"
          loading="lazy"
          sandbox="allow-scripts allow-popups"></iframe>
      </div>
    </section>
  </Main>

  <Footer />
</Layout>
